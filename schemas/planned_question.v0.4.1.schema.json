{
  "$defs": {
    "FactSemanticType": {
      "enum": [
        "OBSERVED_FACT",
        "OBSERVED_EVENT",
        "DERIVED_FACT",
        "SELF_REPORTED_FACT",
        "FUTURE_INTENT"
      ],
      "title": "FactSemanticType",
      "type": "string"
    },
    "MissingFactImpact": {
      "additionalProperties": false,
      "properties": {
        "rate_pp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Pp"
        }
      },
      "title": "MissingFactImpact",
      "type": "object"
    },
    "MissingFactRequest": {
      "additionalProperties": false,
      "properties": {
        "fact_type": {
          "title": "Fact Type",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ResolutionStatus",
          "default": "UNRESOLVED"
        },
        "resolution_strategy": {
          "$ref": "#/$defs/ResolutionStrategy"
        },
        "impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/MissingFactImpact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Source"
        },
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "requested_by_rule_id": {
          "title": "Requested By Rule Id",
          "type": "string"
        },
        "expected_semantic_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactSemanticType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "reward_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Id"
        },
        "grounding_terms": {
          "items": {
            "type": "string"
          },
          "title": "Grounding Terms",
          "type": "array"
        },
        "missing_fact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Fact Id"
        }
      },
      "required": [
        "fact_type",
        "resolution_strategy",
        "requested_by_rule_id"
      ],
      "title": "MissingFactRequest",
      "type": "object"
    },
    "MissingRankingInput": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "title": "Input Id",
          "type": "string"
        },
        "input_type": {
          "const": "CONTRIBUTION_PLAN",
          "default": "CONTRIBUTION_PLAN",
          "title": "Input Type",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "required_field": {
          "title": "Required Field",
          "type": "string"
        },
        "allowed_options": {
          "items": {},
          "title": "Allowed Options",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "affected_metric": {
          "const": "ESTIMATED_AFTER_TAX_INTEREST",
          "default": "ESTIMATED_AFTER_TAX_INTEREST",
          "title": "Affected Metric",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RankingInputStatus",
          "default": "UNRESOLVED"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "product_id",
        "required_field",
        "reason",
        "question"
      ],
      "title": "MissingRankingInput",
      "type": "object"
    },
    "RankingInputStatus": {
      "enum": [
        "UNRESOLVED",
        "RESOLVED",
        "DECLINED"
      ],
      "title": "RankingInputStatus",
      "type": "string"
    },
    "ResolutionStatus": {
      "enum": [
        "RESOLVED",
        "UNRESOLVED",
        "CONFLICT"
      ],
      "title": "ResolutionStatus",
      "type": "string"
    },
    "ResolutionStrategy": {
      "enum": [
        "QUERY_INSTITUTION",
        "QUERY_MYDATA",
        "DERIVE",
        "ASK_USER",
        "UNRESOLVABLE"
      ],
      "title": "ResolutionStrategy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "question_id": {
      "title": "Question Id",
      "type": "string"
    },
    "question_kind": {
      "default": "FINANCIAL_FACT",
      "enum": [
        "FINANCIAL_FACT",
        "RANKING_INPUT"
      ],
      "title": "Question Kind",
      "type": "string"
    },
    "request": {
      "anyOf": [
        {
          "$ref": "#/$defs/MissingFactRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ranking_input": {
      "anyOf": [
        {
          "$ref": "#/$defs/MissingRankingInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "affected_product_ids": {
      "items": {
        "type": "string"
      },
      "title": "Affected Product Ids",
      "type": "array"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Score"
    }
  },
  "required": [
    "question_id",
    "question",
    "affected_product_ids",
    "score"
  ],
  "title": "PlannedQuestion",
  "type": "object"
}
