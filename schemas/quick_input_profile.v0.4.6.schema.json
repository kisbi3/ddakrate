{
  "$defs": {
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/CapabilityState"
        },
        "candidate_filter": {
          "const": false,
          "default": false,
          "title": "Candidate Filter",
          "type": "boolean"
        }
      },
      "required": [
        "capability_id",
        "state"
      ],
      "title": "Capability",
      "type": "object"
    },
    "CapabilityState": {
      "enum": [
        "CAN",
        "UNKNOWN",
        "CANNOT"
      ],
      "title": "CapabilityState",
      "type": "string"
    },
    "HardConstraint": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "constraint": {
          "$ref": "#/$defs/HardConstraintValue"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "default": true,
          "title": "Expected"
        },
        "candidate_filter": {
          "const": true,
          "default": true,
          "title": "Candidate Filter",
          "type": "boolean"
        }
      },
      "required": [
        "field",
        "constraint"
      ],
      "title": "HardConstraint",
      "type": "object"
    },
    "HardConstraintValue": {
      "enum": [
        "REQUIRE",
        "EXCLUDE"
      ],
      "title": "HardConstraintValue",
      "type": "string"
    },
    "NumericPreference": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "direction": {
          "$ref": "#/$defs/NumericPreferenceDirection"
        },
        "strictness": {
          "$ref": "#/$defs/PreferenceStrictness"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        }
      },
      "required": [
        "field",
        "value",
        "direction",
        "strictness"
      ],
      "title": "NumericPreference",
      "type": "object"
    },
    "NumericPreferenceDirection": {
      "enum": [
        "AT_LEAST",
        "AT_MOST",
        "AROUND"
      ],
      "title": "NumericPreferenceDirection",
      "type": "string"
    },
    "Preference": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "preference": {
          "$ref": "#/$defs/PreferenceValue"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "default": true,
          "title": "Expected"
        },
        "candidate_filter": {
          "const": false,
          "default": false,
          "title": "Candidate Filter",
          "type": "boolean"
        }
      },
      "required": [
        "field",
        "preference"
      ],
      "title": "Preference",
      "type": "object"
    },
    "PreferenceStrictness": {
      "enum": [
        "SOFT",
        "HARD"
      ],
      "title": "PreferenceStrictness",
      "type": "string"
    },
    "PreferenceValue": {
      "enum": [
        "PREFER_PRESENT",
        "NEUTRAL",
        "PREFER_ABSENT"
      ],
      "title": "PreferenceValue",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "hard_constraints": {
      "items": {
        "$ref": "#/$defs/HardConstraint"
      },
      "title": "Hard Constraints",
      "type": "array"
    },
    "preferences": {
      "items": {
        "$ref": "#/$defs/Preference"
      },
      "title": "Preferences",
      "type": "array"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "numeric_preferences": {
      "items": {
        "$ref": "#/$defs/NumericPreference"
      },
      "title": "Numeric Preferences",
      "type": "array"
    }
  },
  "title": "QuickInputProfile",
  "type": "object"
}
