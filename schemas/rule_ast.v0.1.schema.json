              {
                "$ref": "#/$defs/OrRule"
              },
              {
                "$ref": "#/$defs/NotRule"
              },
              {
                "$ref": "#/$defs/FactComparisonRule"
              },
              {
                "$ref": "#/$defs/DerivedComparisonRule"
              },
              {
                "$ref": "#/$defs/EntityCountRule"
