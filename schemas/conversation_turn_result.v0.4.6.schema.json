{
  "$defs": {
    "ContributionFeasibilityClarification": {
      "additionalProperties": false,
      "description": "User decision required when contribution state conflicts with affordability.\n\nFor a newly unresolved product input ``feasible_options`` may be empty and the\nuser can adjust the global limit or exclude the product.  When a previously\ncommitted product-specific choice becomes stale after a global-state revision,\nv0.4.4 also exposes the currently feasible replacement options and allows\n``CHANGE_PRODUCT_CONTRIBUTION_CHOICE``.",
      "properties": {
        "clarification_id": {
          "title": "Clarification Id",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "current_affordability_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Current Affordability Amount"
        },
        "current_affordability_frequency": {
          "$ref": "#/$defs/ContributionFrequency"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "current_choice_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Choice Id"
        },
        "current_choice_value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Choice Value"
        },
        "feasible_options": {
          "items": {},
          "title": "Feasible Options",
          "type": "array"
        },
        "minimum_required_affordability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Required Affordability"
        },
        "reason_code": {
          "default": "ALL_CONTRIBUTION_OPTIONS_INFEASIBLE",
          "title": "Reason Code",
          "type": "string"
        },
        "allowed_resolutions": {
          "items": {
            "enum": [
              "CHANGE_PRODUCT_CONTRIBUTION_CHOICE",
              "ADJUST_GLOBAL_AFFORDABILITY",
              "EXCLUDE_PRODUCT"
            ],
            "type": "string"
          },
          "title": "Allowed Resolutions",
          "type": "array"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "clarification_id",
        "product_id",
        "current_affordability_amount",
        "current_affordability_frequency",
        "question"
      ],
      "title": "ContributionFeasibilityClarification",
      "type": "object"
    },
    "ContributionFrequency": {
      "enum": [
        "DAILY",
        "WEEKLY",
        "MONTHLY",
        "FLEXIBLE"
      ],
      "title": "ContributionFrequency",
      "type": "string"
    },
    "ConversationOperation": {
      "description": "Narrow domain operations an LLM may select for a follow-up utterance.\n\nThis is deliberately *not* a universal user-state patch language.  Each action\nmaps to an existing ApplicationService domain operation with deterministic\nvalidation and state ownership.",
      "enum": [
        "UPDATE_SEARCH_INTENT",
        "SET_PRODUCT_CONTRIBUTION_CHOICE",
        "SET_PRODUCT_EXCLUSION",
        "CLEAR_USER_DECLARED_FACT",
        "CLEAR_PRODUCT_CONTRIBUTION_CHOICE",
        "SHOW_CURRENT_RESULTS",
        "REVISE_PRODUCT_CONTRIBUTION_CHOICE",
        "REVISE_USER_ANSWER",
        "REVISE_USER_DECLARED_FACT",
        "SUBMIT_ACTIVE_QUESTION_ANSWER",
        "PROPOSE_ACTIVE_QUESTION_ANSWER",
        "SKIP_ACTIVE_QUESTION",
        "EXPLAIN_ACTIVE_QUESTION",
        "EXCLUDE_PRODUCT",
        "NO_OP",
        "SUBMIT_PRE_SEARCH_ANSWER",
        "ACKNOWLEDGE_PRE_SEARCH_UNKNOWN",
        "SET_PRODUCT_FEATURE_POLICY",
        "CLEAR_PRODUCT_FEATURE_POLICY",
        "REVERT_DECISIONS"
      ],
      "title": "ConversationOperation",
      "type": "string"
    },
    "EligibilityBadge": {
      "enum": [
        "ELIGIBLE",
        "PLAN_REQUIRED",
        "VERIFICATION_REQUIRED",
        "INELIGIBLE"
      ],
      "title": "EligibilityBadge",
      "type": "string"
    },
    "EvaluationStatus": {
      "enum": [
        "SATISFIED",
        "ACHIEVABLE",
        "UNSATISFIABLE",
        "UNKNOWN"
      ],
      "title": "EvaluationStatus",
      "type": "string"
    },
    "FactSemanticType": {
      "enum": [
        "OBSERVED_FACT",
        "OBSERVED_EVENT",
        "DERIVED_FACT",
        "SELF_REPORTED_FACT",
        "FUTURE_INTENT"
      ],
      "title": "FactSemanticType",
      "type": "string"
    },
    "MissingFactImpact": {
      "additionalProperties": false,
      "properties": {
        "rate_pp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Pp"
        }
      },
      "title": "MissingFactImpact",
      "type": "object"
    },
    "MissingFactRequest": {
      "additionalProperties": false,
      "properties": {
        "fact_type": {
          "title": "Fact Type",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ResolutionStatus",
          "default": "UNRESOLVED"
        },
        "resolution_strategy": {
          "$ref": "#/$defs/ResolutionStrategy"
        },
        "impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/MissingFactImpact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Source"
        },
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "requested_by_rule_id": {
          "title": "Requested By Rule Id",
          "type": "string"
        },
        "expected_semantic_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactSemanticType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "reward_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Id"
        },
        "grounding_terms": {
          "items": {
            "type": "string"
          },
          "title": "Grounding Terms",
          "type": "array"
        },
        "missing_fact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Fact Id"
        }
      },
      "required": [
        "fact_type",
        "resolution_strategy",
        "requested_by_rule_id"
      ],
      "title": "MissingFactRequest",
      "type": "object"
    },
    "MissingRankingInput": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "title": "Input Id",
          "type": "string"
        },
        "input_type": {
          "const": "CONTRIBUTION_PLAN",
          "default": "CONTRIBUTION_PLAN",
          "title": "Input Type",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "required_field": {
          "title": "Required Field",
          "type": "string"
        },
        "allowed_options": {
          "items": {},
          "title": "Allowed Options",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "affected_metric": {
          "const": "ESTIMATED_AFTER_TAX_INTEREST",
          "default": "ESTIMATED_AFTER_TAX_INTEREST",
          "title": "Affected Metric",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RankingInputStatus",
          "default": "UNRESOLVED"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "product_id",
        "required_field",
        "reason",
        "question"
      ],
      "title": "MissingRankingInput",
      "type": "object"
    },
    "PlannedQuestion": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "question_kind": {
          "default": "FINANCIAL_FACT",
          "enum": [
            "PRE_SEARCH_PROFILE",
            "FINANCIAL_FACT",
            "RANKING_INPUT",
            "CONTRIBUTION_FEASIBILITY",
            "PROMOTION_RISK_PREFERENCE"
          ],
          "title": "Question Kind",
          "type": "string"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/MissingFactRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ranking_input": {
          "anyOf": [
            {
              "$ref": "#/$defs/MissingRankingInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "feasibility_clarification": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContributionFeasibilityClarification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "affected_product_ids": {
          "items": {
            "type": "string"
          },
          "title": "Affected Product Ids",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Score"
        },
        "product_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Context"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "explanation_details": {
          "additionalProperties": true,
          "title": "Explanation Details",
          "type": "object"
        },
        "question_stage": {
          "anyOf": [
            {
              "const": "PRE_SEARCH",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Stage"
        },
        "pre_search_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pre Search Key"
        },
        "answer_mode": {
          "default": "BINARY",
          "enum": [
            "BINARY",
            "FREE_TEXT",
            "OPTIONS"
          ],
          "title": "Answer Mode",
          "type": "string"
        },
        "confirmation_required": {
          "default": false,
          "title": "Confirmation Required",
          "type": "boolean"
        },
        "answer_examples": {
          "items": {
            "type": "string"
          },
          "title": "Answer Examples",
          "type": "array"
        },
        "question_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "question_id",
        "question",
        "affected_product_ids",
        "score"
      ],
      "title": "PlannedQuestion",
      "type": "object"
    },
    "ProductContributionChoice": {
      "additionalProperties": false,
      "description": "One product-scoped answer required to complete that product's cashflow.\n\nIdentity is semantic and product scoped: ``(product_id, field)``.  This is\ndeliberately not part of ``ProductSearchIntent.contribution_plan`` because a\nstart amount or product-specific term selection must never leak into other\ncandidates.  v0.4.4 adds append-only revision metadata while SearchSession\ncontinues to expose only the latest ACTIVE choice for each semantic key.",
      "properties": {
        "choice_id": {
          "title": "Choice Id",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "value": {
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "source_question_id": {
          "title": "Source Question Id",
          "type": "string"
        },
        "answered_at": {
          "format": "date-time",
          "title": "Answered At",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "record_status": {
          "default": "ACTIVE",
          "enum": [
            "ACTIVE",
            "SUPERSEDED"
          ],
          "title": "Record Status",
          "type": "string"
        },
        "supersedes_choice_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Choice Id"
        }
      },
      "required": [
        "choice_id",
        "product_id",
        "field",
        "value",
        "source_question_id"
      ],
      "title": "ProductContributionChoice",
      "type": "object"
    },
    "ProductRecommendationResult": {
      "additionalProperties": false,
      "properties": {
        "recommendation_id": {
          "title": "Recommendation Id",
          "type": "string"
        },
        "search_session_id": {
          "title": "Search Session Id",
          "type": "string"
        },
        "ranking_objective": {
          "$ref": "#/$defs/RankingObjective"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "top_products": {
          "items": {
            "$ref": "#/$defs/RecommendationListItem"
          },
          "title": "Top Products",
          "type": "array"
        },
        "ranked_products": {
          "items": {
            "$ref": "#/$defs/RecommendationListItem"
          },
          "title": "Ranked Products",
          "type": "array"
        },
        "recommendation_status": {
          "default": "PROVISIONAL",
          "enum": [
            "PROVISIONAL",
            "CONFIRMED"
          ],
          "title": "Recommendation Status",
          "type": "string"
        },
        "provisional_candidates": {
          "items": {
            "$ref": "#/$defs/RecommendationListItem"
          },
          "title": "Provisional Candidates",
          "type": "array"
        },
        "confirmed_top_products": {
          "items": {
            "$ref": "#/$defs/RecommendationListItem"
          },
          "title": "Confirmed Top Products",
          "type": "array"
        },
        "unresolved_question_count": {
          "default": 0,
          "minimum": 0,
          "title": "Unresolved Question Count",
          "type": "integer"
        },
        "acknowledged_unknown_count": {
          "default": 0,
          "minimum": 0,
          "title": "Acknowledged Unknown Count",
          "type": "integer"
        },
        "unresolved_global_assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Global Assumptions",
          "type": "array"
        },
        "ranking_explanation_refs": {
          "items": {
            "type": "string"
          },
          "title": "Ranking Explanation Refs",
          "type": "array"
        },
        "eligibility_text_review_state": {
          "default": "DISABLED",
          "enum": [
            "DISABLED",
            "DEFERRED",
            "COMPLETE",
            "PROVISIONAL",
            "FAILED"
          ],
          "title": "Eligibility Text Review State",
          "type": "string"
        },
        "eligibility_text_review_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Eligibility Text Review Rounds",
          "type": "integer"
        },
        "eligibility_text_review_pending_count": {
          "default": 0,
          "minimum": 0,
          "title": "Eligibility Text Review Pending Count",
          "type": "integer"
        }
      },
      "required": [
        "recommendation_id",
        "search_session_id",
        "ranking_objective",
        "generated_at",
        "top_products"
      ],
      "title": "ProductRecommendationResult",
      "type": "object"
    },
    "QuestionSpec": {
      "additionalProperties": false,
      "description": "Backend-owned question plan consumed by a renderer.",
      "properties": {
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "family_id": {
          "title": "Family Id",
          "type": "string"
        },
        "variable_id": {
          "title": "Variable Id",
          "type": "string"
        },
        "value_schema": {
          "additionalProperties": true,
          "title": "Value Schema",
          "type": "object"
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope",
          "type": "object"
        },
        "bound_requirement_ids": {
          "items": {
            "type": "string"
          },
          "title": "Bound Requirement Ids",
          "type": "array"
        },
        "affected_product_ids": {
          "items": {
            "type": "string"
          },
          "title": "Affected Product Ids",
          "type": "array"
        },
        "options": {
          "items": {},
          "title": "Options",
          "type": "array"
        },
        "prompt_template_id": {
          "title": "Prompt Template Id",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "family_id",
        "variable_id",
        "prompt_template_id"
      ],
      "title": "QuestionSpec",
      "type": "object"
    },
    "RankingComparability": {
      "description": "Whether a candidate can participate in the active ranking metric.\n\nFor the default interest objective, COMPARABLE means the candidate has a\ndeterministic KRW after-tax-interest value.  A rate percentage is never a\nsubstitute for a missing KRW amount.",
      "enum": [
        "COMPARABLE",
        "MISSING_CONTRIBUTION_INPUT",
        "NOT_COMPARABLE"
      ],
      "title": "RankingComparability",
      "type": "string"
    },
    "RankingInputStatus": {
      "enum": [
        "UNRESOLVED",
        "RESOLVED",
        "DECLINED"
      ],
      "title": "RankingInputStatus",
      "type": "string"
    },
    "RankingObjective": {
      "enum": [
        "MAX_ESTIMATED_AFTER_TAX_INTEREST",
        "MAX_ESTIMATED_PRE_TAX_INTEREST",
        "MAX_REALIZABLE_RATE",
        "MIN_ACTION_BURDEN",
        "BALANCED"
      ],
      "title": "RankingObjective",
      "type": "string"
    },
    "RecommendationListItem": {
      "additionalProperties": false,
      "properties": {
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "institution_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Institution Id"
        },
        "institution_name": {
          "title": "Institution Name",
          "type": "string"
        },
        "institution_sector": {
          "default": "UNKNOWN",
          "title": "Institution Sector",
          "type": "string"
        },
        "product_name": {
          "title": "Product Name",
          "type": "string"
        },
        "product_type": {
          "title": "Product Type",
          "type": "string"
        },
        "realizable_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realizable Rate"
        },
        "user_specific_conditional_upper_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Specific Conditional Upper Rate"
        },
        "base_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Rate"
        },
        "advertised_max_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Advertised Max Rate"
        },
        "return_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Kind"
        },
        "published_rate_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Rate Label"
        },
        "published_rate_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Rate Summary"
        },
        "published_rate_as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
