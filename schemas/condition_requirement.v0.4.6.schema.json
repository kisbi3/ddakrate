      "title": "Coverage Status",
      "type": "string"
    },
    "review_status": {
      "default": "REVIEW_REQUIRED",
      "enum": [
        "VERIFIED",
        "REVIEW_REQUIRED",
        "REJECTED"
      ],
      "title": "Review Status",
      "type": "string"
