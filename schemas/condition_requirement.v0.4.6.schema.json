      "type": "string"
    },
    "product_id": {
      "title": "Product Id",
      "type": "string"
    },
    "scope": {
      "enum": [
        "ELIGIBILITY",
        "RATE_BENEFIT",
        "INFORMATION_ONLY"
      ],
      "title": "Scope",
      "type": "string"
    },
    "variable_id": {
      "title": "Variable Id",
      "type": "string"
    },
    "subject_scope": {
      "default": "USER",
      "enum": [
        "USER",
        "ACCOUNT",
        "INSTITUTION",
        "PRODUCT"
      ],
      "title": "Subject Scope",
      "type": "string"
    },
    "institution_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Institution Id"
    },
    "operator": {
      "title": "Operator",
      "type": "string"
    },
    "threshold": {
      "additionalProperties": true,
      "title": "Threshold",
      "type": "object"
    },
    "rate_effect": {
      "additionalProperties": true,
      "title": "Rate Effect",
      "type": "object"
    },
    "relationship": {
      "additionalProperties": true,
      "title": "Relationship",
      "type": "object"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "coverage_status": {
      "default": "COMPLETE",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNAVAILABLE"
