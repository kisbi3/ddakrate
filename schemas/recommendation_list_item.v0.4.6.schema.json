{
  "$defs": {
    "EligibilityBadge": {
      "enum": [
        "ELIGIBLE",
        "PLAN_REQUIRED",
        "VERIFICATION_REQUIRED",
        "INELIGIBLE"
      ],
      "title": "EligibilityBadge",
      "type": "string"
    },
    "EvaluationStatus": {
      "enum": [
        "SATISFIED",
        "ACHIEVABLE",
        "UNSATISFIABLE",
        "UNKNOWN"
      ],
      "title": "EvaluationStatus",
      "type": "string"
    },
    "RankingComparability": {
      "description": "Whether a candidate can participate in the active ranking metric.\n\nFor the default interest objective, COMPARABLE means the candidate has a\ndeterministic KRW after-tax-interest value.  A rate percentage is never a\nsubstitute for a missing KRW amount.",
      "enum": [
        "COMPARABLE",
        "MISSING_CONTRIBUTION_INPUT",
        "NOT_COMPARABLE"
      ],
      "title": "RankingComparability",
      "type": "string"
    },
    "VerificationBadge": {
      "enum": [
        "FINANCIAL_DATA_VERIFIED",
        "USER_RESPONSE_INCLUDED",
        "PLAN_BASED",
        "ADDITIONAL_VERIFICATION_REQUIRED"
      ],
      "title": "VerificationBadge",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "rank": {
      "minimum": 1,
      "title": "Rank",
      "type": "integer"
    },
    "product_id": {
      "title": "Product Id",
      "type": "string"
    },
    "institution_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Institution Id"
    },
    "institution_name": {
      "title": "Institution Name",
      "type": "string"
    },
    "institution_sector": {
      "default": "UNKNOWN",
      "title": "Institution Sector",
      "type": "string"
    },
    "product_name": {
      "title": "Product Name",
      "type": "string"
    },
    "product_type": {
      "title": "Product Type",
      "type": "string"
    },
    "realizable_rate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Realizable Rate"
    },
    "user_specific_conditional_upper_rate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
