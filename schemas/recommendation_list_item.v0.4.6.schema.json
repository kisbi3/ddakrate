  "required": [
    "rank",
    "product_id",
    "institution_name",
    "product_name",
    "product_type",
    "term_summary",
    "contribution_summary",
    "maximum_deposit_summary",
    "planned_contribution_summary",
    "eligibility_badge",
    "verification_badge",
    "material_unknown_count"
