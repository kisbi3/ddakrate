    "ranking_comparability": {
      "$ref": "#/$defs/RankingComparability",
      "default": "COMPARABLE"
    },
    "missing_ranking_input_count": {
      "default": 0,
      "minimum": 0,
      "title": "Missing Ranking Input Count",
      "type": "integer"
    },
    "eligibility_badge": {
      "$ref": "#/$defs/EligibilityBadge"
    },
    "verification_badge": {
      "$ref": "#/$defs/VerificationBadge"
    },
    "material_unknown_count": {
      "minimum": 0,
      "title": "Material Unknown Count",
      "type": "integer"
    },
    "eligibility_text_review_status": {
      "anyOf": [
