{
  "$defs": {
    "ContributionFeasibilityClarification": {
      "additionalProperties": false,
      "description": "User decision required when contribution state conflicts with affordability.\n\nFor a newly unresolved product input ``feasible_options`` may be empty and the\nuser can adjust the global limit or exclude the product.  When a previously\ncommitted product-specific choice becomes stale after a global-state revision,\nv0.4.4 also exposes the currently feasible replacement options and allows\n``CHANGE_PRODUCT_CONTRIBUTION_CHOICE``.",
      "properties": {
        "clarification_id": {
          "title": "Clarification Id",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "current_affordability_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Current Affordability Amount"
        },
        "current_affordability_frequency": {
          "$ref": "#/$defs/ContributionFrequency"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "current_choice_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Choice Id"
        },
        "current_choice_value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Choice Value"
        },
        "feasible_options": {
          "items": {},
          "title": "Feasible Options",
          "type": "array"
        },
        "minimum_required_affordability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Required Affordability"
        },
        "reason_code": {
          "default": "ALL_CONTRIBUTION_OPTIONS_INFEASIBLE",
          "title": "Reason Code",
          "type": "string"
        },
        "allowed_resolutions": {
          "items": {
            "enum": [
              "CHANGE_PRODUCT_CONTRIBUTION_CHOICE",
              "ADJUST_GLOBAL_AFFORDABILITY",
              "EXCLUDE_PRODUCT"
            ],
            "type": "string"
          },
          "title": "Allowed Resolutions",
          "type": "array"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "clarification_id",
        "product_id",
        "current_affordability_amount",
        "current_affordability_frequency",
        "question"
      ],
      "title": "ContributionFeasibilityClarification",
      "type": "object"
    },
    "ContributionFrequency": {
      "enum": [
        "DAILY",
        "WEEKLY",
        "MONTHLY",
        "FLEXIBLE"
      ],
      "title": "ContributionFrequency",
      "type": "string"
    },
    "FactSemanticType": {
      "enum": [
        "OBSERVED_FACT",
        "OBSERVED_EVENT",
        "DERIVED_FACT",
        "SELF_REPORTED_FACT",
        "FUTURE_INTENT"
      ],
      "title": "FactSemanticType",
      "type": "string"
    },
    "MissingFactImpact": {
      "additionalProperties": false,
      "properties": {
        "rate_pp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Pp"
        }
      },
      "title": "MissingFactImpact",
      "type": "object"
    },
    "MissingFactRequest": {
      "additionalProperties": false,
      "properties": {
        "fact_type": {
          "title": "Fact Type",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ResolutionStatus",
          "default": "UNRESOLVED"
        },
        "resolution_strategy": {
          "$ref": "#/$defs/ResolutionStrategy"
        },
        "impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/MissingFactImpact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Source"
        },
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "requested_by_rule_id": {
          "title": "Requested By Rule Id",
          "type": "string"
        },
        "expected_semantic_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactSemanticType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "reward_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Id"
        },
        "grounding_terms": {
          "items": {
            "type": "string"
          },
          "title": "Grounding Terms",
          "type": "array"
        },
        "missing_fact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Fact Id"
        }
      },
      "required": [
        "fact_type",
        "resolution_strategy",
        "requested_by_rule_id"
      ],
      "title": "MissingFactRequest",
      "type": "object"
    },
    "MissingRankingInput": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "title": "Input Id",
          "type": "string"
        },
        "input_type": {
          "const": "CONTRIBUTION_PLAN",
          "default": "CONTRIBUTION_PLAN",
          "title": "Input Type",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "required_field": {
          "title": "Required Field",
          "type": "string"
        },
        "allowed_options": {
          "items": {},
          "title": "Allowed Options",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "affected_metric": {
          "const": "ESTIMATED_AFTER_TAX_INTEREST",
          "default": "ESTIMATED_AFTER_TAX_INTEREST",
          "title": "Affected Metric",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RankingInputStatus",
          "default": "UNRESOLVED"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "product_id",
        "required_field",
        "reason",
        "question"
      ],
      "title": "MissingRankingInput",
      "type": "object"
    },
    "QuestionSpec": {
      "additionalProperties": false,
      "description": "Backend-owned question plan consumed by a renderer.",
      "properties": {
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "family_id": {
          "title": "Family Id",
          "type": "string"
        },
        "variable_id": {
          "title": "Variable Id",
          "type": "string"
        },
        "value_schema": {
          "additionalProperties": true,
          "title": "Value Schema",
          "type": "object"
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope",
          "type": "object"
        },
        "bound_requirement_ids": {
          "items": {
            "type": "string"
          },
          "title": "Bound Requirement Ids",
          "type": "array"
        },
        "affected_product_ids": {
          "items": {
            "type": "string"
          },
          "title": "Affected Product Ids",
          "type": "array"
        },
        "options": {
          "items": {},
          "title": "Options",
          "type": "array"
        },
        "prompt_template_id": {
          "title": "Prompt Template Id",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "family_id",
        "variable_id",
        "prompt_template_id"
      ],
      "title": "QuestionSpec",
      "type": "object"
    },
    "RankingInputStatus": {
      "enum": [
        "UNRESOLVED",
        "RESOLVED",
        "DECLINED"
      ],
      "title": "RankingInputStatus",
      "type": "string"
    },
    "ResolutionStatus": {
      "enum": [
        "RESOLVED",
        "UNRESOLVED",
        "CONFLICT"
      ],
      "title": "ResolutionStatus",
      "type": "string"
    },
    "ResolutionStrategy": {
      "enum": [
        "QUERY_INSTITUTION",
        "QUERY_MYDATA",
        "DERIVE",
        "ASK_USER",
        "UNRESOLVABLE"
      ],
      "title": "ResolutionStrategy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "question_id": {
      "title": "Question Id",
      "type": "string"
    },
    "question_kind": {
      "default": "FINANCIAL_FACT",
      "enum": [
        "PRE_SEARCH_PROFILE",
        "FINANCIAL_FACT",
        "RANKING_INPUT",
        "CONTRIBUTION_FEASIBILITY",
        "PROMOTION_RISK_PREFERENCE"
      ],
      "title": "Question Kind",
      "type": "string"
    },
    "request": {
      "anyOf": [
        {
          "$ref": "#/$defs/MissingFactRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ranking_input": {
      "anyOf": [
        {
          "$ref": "#/$defs/MissingRankingInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "feasibility_clarification": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContributionFeasibilityClarification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "affected_product_ids": {
      "items": {
        "type": "string"
      },
      "title": "Affected Product Ids",
      "type": "array"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Score"
    },
    "product_context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Context"
    },
    "explanation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Explanation"
    },
    "explanation_details": {
      "additionalProperties": true,
      "title": "Explanation Details",
      "type": "object"
    },
    "question_stage": {
      "anyOf": [
        {
          "const": "PRE_SEARCH",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question Stage"
    },
    "pre_search_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pre Search Key"
    },
    "answer_mode": {
      "default": "BINARY",
      "enum": [
        "BINARY",
        "FREE_TEXT",
        "OPTIONS"
      ],
      "title": "Answer Mode",
      "type": "string"
    },
    "confirmation_required": {
      "default": false,
      "title": "Confirmation Required",
      "type": "boolean"
    },
    "answer_examples": {
      "items": {
        "type": "string"
      },
      "title": "Answer Examples",
      "type": "array"
    },
    "question_spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/QuestionSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "question_id",
    "question",
    "affected_product_ids",
    "score"
  ],
  "title": "PlannedQuestion",
  "type": "object"
}
