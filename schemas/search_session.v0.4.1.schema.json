{
  "$defs": {
    "SearchSessionStatus": {
      "enum": [
        "INTENT_COLLECTION",
        "CLARIFICATION_REQUIRED",
        "CANDIDATES_RETRIEVED",
        "QUESTIONING",
        "RANKING_READY",
        "COMPLETED"
      ],
      "title": "SearchSessionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "search_session_id": {
      "title": "Search Session Id",
      "type": "string"
    },
    "user_id": {
      "title": "User Id",
      "type": "string"
    },
    "intent_version": {
      "default": 1,
      "minimum": 1,
      "title": "Intent Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/SearchSessionStatus",
      "default": "INTENT_COLLECTION"
    },
    "candidate_product_ids": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Product Ids",
      "type": "array"
    },
    "active_question_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Question Id"
    },
    "answered_question_ids": {
      "items": {
        "type": "string"
      },
      "title": "Answered Question Ids",
      "type": "array"
    },
    "ranking_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ranking Run Id"
    },
    "recommendation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommendation Id"
    },
    "top_k": {
      "default": 5,
      "maximum": 20,
      "minimum": 1,
      "title": "Top K",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "search_session_id",
    "user_id"
  ],
  "title": "SearchSession",
  "type": "object"
}
