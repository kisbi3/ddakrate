{
  "$defs": {
    "EvaluationStatus": {
      "enum": [
        "SATISFIED",
        "ACHIEVABLE",
        "UNSATISFIABLE",
        "UNKNOWN"
      ],
      "title": "EvaluationStatus",
      "type": "string"
    },
    "MissingRankingInput": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "title": "Input Id",
          "type": "string"
        },
        "input_type": {
          "const": "CONTRIBUTION_PLAN",
          "default": "CONTRIBUTION_PLAN",
          "title": "Input Type",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "required_field": {
          "title": "Required Field",
          "type": "string"
        },
        "allowed_options": {
          "items": {},
          "title": "Allowed Options",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "affected_metric": {
          "const": "ESTIMATED_AFTER_TAX_INTEREST",
          "default": "ESTIMATED_AFTER_TAX_INTEREST",
          "title": "Affected Metric",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RankingInputStatus",
          "default": "UNRESOLVED"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "product_id",
        "required_field",
        "reason",
        "question"
      ],
      "title": "MissingRankingInput",
      "type": "object"
    },
    "PersonalizedRecommendationReason": {
      "additionalProperties": false,
      "properties": {
        "positives": {
          "items": {
            "type": "string"
          },
          "title": "Positives",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "actions": {
          "items": {
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        },
        "positive_entries": {
          "items": {
            "$ref": "#/$defs/RecommendationReasonEntry"
          },
          "title": "Positive Entries",
          "type": "array"
        },
        "limitation_entries": {
          "items": {
            "$ref": "#/$defs/RecommendationReasonEntry"
          },
          "title": "Limitation Entries",
          "type": "array"
        },
        "action_entries": {
          "items": {
            "$ref": "#/$defs/RecommendationReasonEntry"
          },
          "title": "Action Entries",
          "type": "array"
        },
        "unknown_entries": {
          "items": {
            "$ref": "#/$defs/RecommendationReasonEntry"
          },
          "title": "Unknown Entries",
          "type": "array"
        }
      },
      "title": "PersonalizedRecommendationReason",
      "type": "object"
    },
    "ProductSearchFacts": {
      "additionalProperties": false,
      "description": "Stable search projection shared by every financial-product family.\n\nCategory-specific canonical policies remain lossless in ``NormalizedProductData``.\nThis projection exposes only typed facts that deterministic retrieval may safely\ncompare; missing facts stay ``None`` and never become negative evidence.",
      "properties": {
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "product_family": {
          "title": "Product Family",
          "type": "string"
        },
        "product_subtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Subtype"
        },
        "institution_sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Institution Sector"
        },
        "sale_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sale Status"
        },
        "open_ended": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open Ended"
        },
        "customer_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Customer Scopes",
          "type": "array"
        },
        "subscription_channels": {
          "items": {
            "type": "string"
          },
          "title": "Subscription Channels",
          "type": "array"
        },
        "funding_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Funding Type"
        },
        "contribution_frequency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contribution Frequency"
        },
        "return_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Kind"
        },
        "protection_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protection Status"
        },
        "reinvestment_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reinvestment Mode"
        },
        "balance_tier_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Balance Tier Method"
        },
        "fee_waiver_available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fee Waiver Available"
        },
        "interest_payment_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interest Payment Method"
        },
        "classifications": {
          "items": {
            "type": "string"
          },
          "title": "Classifications",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "product_family"
      ],
      "title": "ProductSearchFacts",
      "type": "object"
    },
    "RankingComparability": {
      "description": "Whether a candidate can participate in the active ranking metric.\n\nFor the default interest objective, COMPARABLE means the candidate has a\ndeterministic KRW after-tax-interest value.  A rate percentage is never a\nsubstitute for a missing KRW amount.",
      "enum": [
        "COMPARABLE",
        "MISSING_CONTRIBUTION_INPUT",
        "NOT_COMPARABLE"
      ],
      "title": "RankingComparability",
      "type": "string"
    },
    "RankingInputStatus": {
      "enum": [
        "UNRESOLVED",
        "RESOLVED",
        "DECLINED"
      ],
      "title": "RankingInputStatus",
      "type": "string"
    },
    "RankingObjective": {
      "enum": [
        "MAX_ESTIMATED_AFTER_TAX_INTEREST",
        "MAX_ESTIMATED_PRE_TAX_INTEREST",
        "MAX_REALIZABLE_RATE",
        "MIN_ACTION_BURDEN",
        "BALANCED"
      ],
      "title": "RankingObjective",
      "type": "string"
    },
    "RateBreakdownItem": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_label": {
          "title": "Rule Label",
          "type": "string"
        },
        "nominal_reward_pp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nominal Reward Pp"
        },
        "status": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "verification_level": {
          "$ref": "#/$defs/VerificationLevel"
        },
        "evidence_basis": {
          "title": "Evidence Basis",
          "type": "string"
        },
        "action_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Summary"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "source_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "disclosure_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disclosure Id"
        },
        "presentation": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Presentation"
        },
        "disclosure_verification_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disclosure Verification Status"
        },
        "user_condition_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserConditionStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "display_status": {
          "enum": [
            "적용 예상",
            "확인 전",
            "적용 안 함",
            "확인 완료"
          ],
          "title": "Display Status",
          "type": "string"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/RateBreakdownItem"
          },
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "rule_label",
        "status",
        "verification_level",
        "evidence_basis",
        "reason_code",
        "display_status"
      ],
      "title": "RateBreakdownItem",
      "type": "object"
    },
    "RateCapAdjustment": {
      "additionalProperties": false,
      "properties": {
        "cap_pp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cap Pp"
        },
        "pre_cap_total_pp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pre Cap Total Pp"
        },
        "cap_reduction_pp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cap Reduction Pp"
        },
        "post_cap_total_pp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Cap Total Pp"
        }
      },
      "title": "RateCapAdjustment",
      "type": "object"
    },
    "RateContribution": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "nominal_reward_pp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Nominal Reward Pp"
        },
        "status": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "evidence_bucket": {
          "title": "Evidence Bucket",
          "type": "string"
        },
        "included_in_confirmed": {
          "title": "Included In Confirmed",
          "type": "boolean"
        },
        "included_in_realizable": {
          "title": "Included In Realizable",
          "type": "boolean"
        },
        "included_in_conditional_upper": {
          "title": "Included In Conditional Upper",
          "type": "boolean"
        }
      },
      "required": [
        "rule_id",
        "nominal_reward_pp",
        "status",
        "evidence_bucket",
        "included_in_confirmed",
        "included_in_realizable",
        "included_in_conditional_upper"
      ],
      "title": "RateContribution",
      "type": "object"
    },
    "RateEvaluationResult": {
      "additionalProperties": false,
      "description": "Family-neutral financial result consumed by search and ranking.\n\nThe legacy flattened fields on :class:`CandidateEvaluation` remain available\nfor API compatibility. New search/ranking code should use this contract so a\ndeposit, savings account, parking account, and CMA expose the same outcome\nwithout pretending that their internal calculations are identical.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "product_family": {
          "title": "Product Family",
          "type": "string"
        },
        "calculation_mode": {
          "enum": [
            "INSTALLMENT_CASHFLOW",
            "LUMP_SUM_TERM",
            "ON_DEMAND_BALANCE",
            "CMA_POSTED_YIELD",
            "CMA_PERFORMANCE_LINKED",
            "GENERIC_RATE"
          ],
          "title": "Calculation Mode",
          "type": "string"
        },
        "return_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Kind"
        },
        "calculation_status": {
          "enum": [
            "CALCULATED",
            "UNSUPPORTED",
            "UNKNOWN"
          ],
          "title": "Calculation Status",
          "type": "string"
        },
        "calculation_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Reason"
        },
        "eligibility_status": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "confirmed_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed Rate"
        },
        "realizable_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realizable Rate"
        },
        "user_specific_conditional_upper_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Specific Conditional Upper Rate"
        },
        "advertised_max_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Advertised Max Rate"
        },
        "rate_as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate As Of"
        },
        "selected_term_value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Term Value"
        },
        "selected_term_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/TermUnit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scenario_principal": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Principal"
        },
        "customer_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer Scope"
        },
        "comparison_basis": {
          "default": "UNKNOWN",
          "enum": [
            "ANNUAL_PERCENT_RATE",
            "PERFORMANCE_LINKED_RETURN",
            "UNKNOWN"
          ],
          "title": "Comparison Basis",
          "type": "string"
        },
        "rate_comparable": {
          "default": false,
          "title": "Rate Comparable",
          "type": "boolean"
        },
        "interest_comparable": {
          "default": false,
          "title": "Interest Comparable",
          "type": "boolean"
        },
        "ranking_comparability": {
          "$ref": "#/$defs/RankingComparability",
          "default": "NOT_COMPARABLE"
        },
        "applied_condition_ids": {
          "items": {
            "type": "string"
          },
          "title": "Applied Condition Ids",
          "type": "array"
        },
        "missing_fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "product_family",
        "calculation_mode",
        "calculation_status",
        "eligibility_status"
      ],
      "title": "RateEvaluationResult",
      "type": "object"
    },
    "RecommendationReasonEntry": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "code",
        "text"
      ],
      "title": "RecommendationReasonEntry",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "title": "Document",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "version_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Date"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        }
      },
      "required": [
        "document"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "TermUnit": {
      "enum": [
        "DAY",
        "WEEK",
        "MONTH",
        "YEAR"
      ],
      "title": "TermUnit",
      "type": "string"
    },
    "UserConditionStatus": {
      "description": "Session-local lifecycle of a canonical user variable.",
      "enum": [
        "NOT_ASKED",
        "DECLINED",
        "DECLARED_FEASIBLE",
        "WILLING_UNSPECIFIED",
        "ACKNOWLEDGED_UNKNOWN",
        "VERIFIED"
      ],
      "title": "UserConditionStatus",
      "type": "string"
    },
    "VerificationLevel": {
      "description": "User-facing evidence classification for an evaluated rule/result.",
      "enum": [
        "INSTITUTION_VERIFIED",
        "MYDATA_VERIFIED",
        "DERIVED",
        "SELF_REPORTED",
        "USER_INTENT",
        "MIXED",
        "UNKNOWN",
        "VERIFIED"
      ],
      "title": "VerificationLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "recommendation_id": {
      "title": "Recommendation Id",
      "type": "string"
    },
    "search_session_id": {
      "title": "Search Session Id",
      "type": "string"
    },
    "product_id": {
      "title": "Product Id",
      "type": "string"
    },
    "product_name": {
      "title": "Product Name",
      "type": "string"
    },
    "institution_name": {
      "title": "Institution Name",
      "type": "string"
    },
    "product_type": {
      "title": "Product Type",
      "type": "string"
    },
    "rank": {
      "title": "Rank",
      "type": "integer"
    },
    "ranking_objective": {
      "$ref": "#/$defs/RankingObjective",
      "default": "MAX_REALIZABLE_RATE"
