# -----------------------------------------------------------------------------
# LLM runtime
# -----------------------------------------------------------------------------
# Change only LLM_PROVIDER and LLM_MODEL when switching runtimes. "auto" lets
# the provider/model registry select a compatible endpoint and request controls.
LLM_PROVIDER=MOCK
ELIGIBILITY_CATALOG_MODE=NORMALIZED
LLM_BASE_URL=auto
LLM_MODEL=auto
LLM_REASONING_EFFORT=auto

# Native OpenAI example (Responses API + Structured Outputs):
# LLM_PROVIDER=OPENAI
# LLM_MODEL=gpt-5.6-luna
# OPENAI_API_KEY=   # accepted as a fallback when LLM_API_KEY is unset
# LLM_REASONING_EFFORT=auto

# Third-party/local OpenAI-compatible Chat Completions example:
# LLM_PROVIDER=OPENAI_COMPATIBLE
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=your-model
# LLM_API_KEY=

LLM_API_KEY=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Applied only when the resolved model profile supports temperature.
LLM_TEMPERATURE=0
LLM_LOG_PAYLOAD_MODE=REDACTED

# Review every numeric rank <= 3 against the complete published eligibility text.
ELIGIBILITY_TEXT_TOP_RANK_REVIEW_ENABLED=true
ELIGIBILITY_TEXT_REVIEW_MAX_ROUNDS=10

# -----------------------------------------------------------------------------
# Web runtime
# -----------------------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Private debug history is written here for review in a later Codex session.
# It stores redacted raw history only; it does not restore a SearchSession.
# ELIGIBILITY_DEBUG_HISTORY_DIR=/absolute/path/to/ddakrate/.runtime/debug-history
# Most PaaS products inject PORT automatically; eligibility-web honors it first.
# PORT=8000
# Bundled executable 50-product catalog is used by default. Override only when
# testing another catalog directory.
# ELIGIBILITY_PRODUCT_CATALOG_PATH=/absolute/path/to/product_catalog
# External eval harness (/__eval/*). Unset means the routes are not mounted at
# all. Set it only for a local eval run, with a freshly generated random value:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# ELIGIBILITY_EVAL_TOKEN=

# -----------------------------------------------------------------------------
# FSC financial institution master-data collector
# -----------------------------------------------------------------------------
# Keep the service key only in local .env (ignored) or the process environment.
# The collector never accepts this value as a command-line argument.
# FSC_OPENAPI_SERVICE_KEY=
