# -----------------------------------------------------------------------------
# LLM runtime
# -----------------------------------------------------------------------------
# Change only LLM_PROVIDER and LLM_MODEL when switching runtimes. "auto" lets
# the provider/model registry select a compatible endpoint and request controls.
LLM_PROVIDER=MOCK
LLM_BASE_URL=auto
LLM_MODEL=auto
LLM_REASONING_EFFORT=auto

# Native OpenAI example (Responses API + Structured Outputs):
# LLM_PROVIDER=OPENAI
# LLM_MODEL=gpt-5.6-luna
# OPENAI_API_KEY=   # accepted as a fallback when LLM_API_KEY is unset
# LLM_REASONING_EFFORT=auto

# Third-party/local OpenAI-compatible Chat Completions example:
# LLM_PROVIDER=OPENAI_COMPATIBLE
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=your-model
# LLM_API_KEY=

LLM_API_KEY=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Applied only when the resolved model profile supports temperature.
LLM_TEMPERATURE=0
LLM_LOG_PAYLOAD_MODE=REDACTED

# -----------------------------------------------------------------------------
# Web runtime
# -----------------------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Most PaaS products inject PORT automatically; eligibility-web honors it first.
# PORT=8000
# Bundled executable 50-product catalog is used by default. Override only when
# testing another catalog directory.
# ELIGIBILITY_PRODUCT_CATALOG_PATH=/absolute/path/to/product_catalog
