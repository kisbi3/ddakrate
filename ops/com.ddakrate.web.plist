<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ddakrate.web</string>

  <key>ProgramArguments</key>
  <array>
    <string>/path/to/ddakrate/scripts/run_web_background.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>WEB_HOST</key>
    <string>0.0.0.0</string>
    <key>WEB_PORT</key>
    <string>57949</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>LimitLoadToSessionType</key>
  <array>
    <string>Aqua</string>
    <string>Background</string>
  </array>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
</dict>
</plist>
