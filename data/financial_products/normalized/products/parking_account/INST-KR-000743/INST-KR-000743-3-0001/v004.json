            "max_value": "100000000",
            "max_inclusive": true,
            "source_text": "이자계산기간 동안 매일 최종잔액 중 1억원 이하 금액"
          },
          "source_text": "이자계산기간 동안 매일 최종잔액 중 1억원 이하 금액"
        },
