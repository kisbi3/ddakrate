      "EVD-TD-20260829-INST-KR-000211-2-C88802EE164"
    ],
    "contexts": [
      {
        "context_id": "MATURITY_PAYMENT",
        "payment_timing": "MATURITY",
        "compounding": "SIMPLE",
        "calculation_formula": "원금 × 가입기간별 이율 × 일수 ÷ 365",
        "source_text": "만기이자지급식 : 만기에 이자지급; 원금 X 가입기간별 이율 X 일수 ÷ 365"
      },
      {
        "context_id": "MONTHLY_PAYMENT",
        "payment_timing": "MONTHLY",
        "compounding": "SIMPLE",
        "calculation_formula": "원금 × 가입기간별 이율 × 월수 ÷ 12",
        "source_text": "월이자지급식 : 매월 이자지급; 원금 X 가입기간별 이율 X 월수 ÷ 12"
      }
    ]
  },
