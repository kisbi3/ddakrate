  "interest_payment_policy": {
    "multiple_contexts": true,
    "default_context_id": "MATURITY_LUMP_SUM",
    "default_context_derivation": "NAVER_PRODUCT_GUIDE_AND_12_MONTH_SIMPLE_CALCULATOR",
    "source_text": "만기일시지급식 : 만기(후) 또는 중도해지 요청 시 이자를 지급; 월이자지급식은 중도해지 시 기지급 이자와 중도해지이율 적용 이자의 차액을 원금에서 차감하여 지급",
    "source_ref_ids": [
      "EVD-TD-20260829-INST-KR-000204-2-CE6CAA1411A"
    ],
    "contexts": [
      {
        "context_id": "MATURITY_LUMP_SUM",
        "interest_method": "SIMPLE",
        "payment_timing": "AT_MATURITY",
        "payment_amount": "PRINCIPAL_AND_INTEREST",
        "early_termination_payment_timing": "ON_EARLY_TERMINATION_REQUEST"
      },
      {
        "context_id": "MONTHLY_INTEREST_PAYMENT",
        "interest_method": "NOT_STATED",
        "payment_timing": "MONTHLY",
        "early_termination_payment_timing": "ON_EARLY_TERMINATION_REQUEST",
        "early_termination_reconciliation": "DEDUCT_PREPAID_INTEREST_EXCESS_FROM_PRINCIPAL",
        "source_text": "월이자지급식은 중도해지 시에는 기지급 이자와 중도해지이율을 적용한 중도해지 이자의 차액을 원금에서 차감하여 지급"
      }
    ]
  },
  "liquidity_policy": {
    "access_mode": "AT_MATURITY",
    "early_termination_allowed": true,
    "early_termination_rate_policy": {
      "status": "ORDINARY_RATE_TABLE_NOT_STATED",
      "source_text": "만기 전 해지할 경우 약정한 이율보다 낮은 중도해지 이율이 적용되나 구간별 표·산식은 Naver 원문에 미기재"
    },
    "rollover_policy": {
      "mode": "OPTIONAL_AUTOMATIC_REINVESTMENT",
      "maximum_reinvestment_count": 5,
      "reinvestment_event": "EACH_CONTRACT_TERM_MATURITY",
      "principal_treatment": "REINVEST_SAME_CONDITIONS",
      "interest_treatment": "DEPOSIT_TO_WITHDRAWAL_ACCOUNT_REGISTERED_AT_ACCOUNT_OPENING",
      "tax_savings_excess_treatment": "REINVEST_AS_GENERAL_TAXATION",
      "not_reinvested_conditions": [
        "SUBSCRIPTION_LIMIT_EXCEEDED",
        "LEGAL_PAYMENT_RESTRICTION",
        "OTHER_AUTOMATIC_REINVESTMENT_IMPOSSIBILITY"
      ],
      "source_text": "자동재예치를 신청한 경우 총 5회까지 매 계약기간 만기일마다 원금은 동일한 조건으로 재예치하고, 이자는 계좌개설 시 출금계좌로 입금한다. 비과세종합저축 한도초과 계좌는 일반과세로 전환하여 재예치하며 가입한도 초과·법적지급제한 등으로 불가하면 재예치되지 않는다."
    },
    "automatic_termination_policy": {
      "excluded_when_payment_restriction": true,
      "blocking_examples": [
        "SEIZURE",
        "COLLATERAL_SECURITY_SETTING",
        "CAUTION_CODE"
      ],
      "source_text": "압류, 담보설정, 주의코드 설정 등 지급제한 사유가 있는 경우에는 자동해지에서 제외"
    },
    "source_ref_ids": [
      "EVD-TD-20260829-INST-KR-000204-2-CE6CAA1411A"
    ]
  },
  "protection_policy": {
    "coverage_status": "PROTECTED",
    "coverage_limit_krw": "100000000",
    "scheme_ref": {
      "scheme_code": "KDIC-DEPOSIT-PROTECTION",
      "version": 1
    },
    "coverage_basis": "PER_PERSON_ALL_PROTECTED_DEPOSITS_PRINCIPAL_AND_STATUTORY_INTEREST",
    "source_text": "예금자보호법에 따라 원금과 소정 이자를 합해 전북은행 여타 보호상품과 합산하여 1인당 1억원까지 보호",
    "source_ref_ids": [
      "EVD-TD-20260829-INST-KR-000204-2-CE6CAA1411A"
    ]
  },
  "tax_policy": {
    "default_treatment": "TAXABLE",
    "source_text": "Naver 12개월 만기 계산은 이자과세 15.4%를 표시한다. 자동재예치 때 비과세종합저축 한도초과 계좌는 일반과세로 전환해 재예치한다.",
